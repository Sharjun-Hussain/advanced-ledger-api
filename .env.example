# Server
PORT=5000
NODE_ENV=development

# MySQL database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ledger_lk

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins (web admin + any frontends)
CORS_ORIGINS=http://localhost:5173

# SMS gateway (Dialog/Mobitel) - fill when you get API credentials
SMS_PROVIDER=dialog
SMS_API_KEY=
SMS_SENDER_ID=LedgerLK

# Admin bootstrap credentials for first run
ADMIN_PHONE=0710000000
ADMIN_PASSWORD=Admin@123
